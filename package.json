{
  "name": "splitroads",
  "private": true,
  "version": "0.0.1",
  "description": "Split-Roads — Decision Intelligence Platform for Traders",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:migrate": "pnpm --filter @splitroads/api db:migrate",
    "db:generate": "pnpm --filter @splitroads/api db:generate"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.5.3",
    "typescript": "^5.7.3",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "eslint": "^9.17.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.14.4"
}

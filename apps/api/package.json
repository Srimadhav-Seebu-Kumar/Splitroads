{
  "name": "@splitroads/api",
  "version": "0.1.0",
  "description": "Split-Roads API server (Fastify)",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "lint": "eslint src",
    "db:migrate": "tsx --env-file=.env src/lib/migrate.ts",
    "db:seed:dev": "tsx --env-file=.env src/lib/seed-dev.ts"
  },
  "dependencies": {
    "@splitroads/contracts": "workspace:*",
    "fastify": "^5.2.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "fastify-plugin": "^5.0.1",
    "argon2": "^0.43.0",
    "postgres": "^3.4.5",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1",
    "uuid": "^11.0.5",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.1.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2"
  }
}

# Copy to .env for local development

# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://splitroads:splitroads_dev_only@localhost:5432/splitroads

# Redis
REDIS_URL=redis://localhost:6379

# Redpanda / Kafka
KAFKA_BROKERS=localhost:19092

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=replace_with_32_byte_hex_secret_dev_only
JWT_EXPIRES_IN=7d

# Encryption key for broker credentials (AES-256-GCM, 32 bytes hex)
CREDENTIAL_ENCRYPTION_KEY=replace_with_32_byte_hex_secret_dev_only

# Market data
MARKET_DATA_PROVIDER=polygon  # polygon | twelvedata | local_csv
POLYGON_API_KEY=

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:3000
